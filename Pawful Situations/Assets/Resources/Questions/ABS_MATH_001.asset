  m_Name: ABS_MATH_001
  m_EditorClassIdentifier: 
  questions:
  - id: Tommy
    prompt: Tommy has 54 pizza slices. He wants to share it among his friends. Tommy
      has no friends. How many slices of pizza do Tommy's friends get?
    choices:
    - Tommy can't eat no more pizza
    - You can't divide by 0 you sick fuck.
    - Assume he's friends with himself.
    - Phone a friend.
    correctIndex: 1
  - id: Apple Jack
    prompt: Jack has 12 apples. Jack's ex takes 7, his friend takes 4, and one rolls
      under the fridge. How many apples do you have left and how much emotional baggage?
    choices:
    - 1 apple, infinite baggage
    - Send good ol' daisy the dog to fetch the apple.
    - Should have done a prenup.
    - -1 apple
    correctIndex: 0
